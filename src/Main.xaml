<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="帧剪 FrameCut · 绿色版" Width="1320" Height="870" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#101317" Foreground="#E5EAF0" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12" AllowDrop="True" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#8995A5"/>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#262D37"/><Setter Property="Foreground" Value="#DDE5EF"/><Setter Property="BorderBrush" Value="#35404D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#74E0B3"/><Setter Property="BorderBrush" Value="#74E0B3"/><Setter Property="Foreground" Value="#0F2A20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#131920"/><Setter Property="Foreground" Value="#ECF2F8"/><Setter Property="BorderBrush" Value="#364251"/><Setter Property="Padding" Value="9,6"/><Setter Property="CaretBrush" Value="#74E0B3"/><Setter Property="SelectionBrush" Value="#358668"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#CBD5E1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="#18212A"/><Setter Property="Margin" Value="0,4"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#E5EAF0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Box" BorderBrush="#303B46" BorderThickness="1" Background="#1C232B" CornerRadius="6" Padding="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#74E0B3"/><Setter TargetName="Box" Property="Background" Value="#203A32"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid x:Name="Editor"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="210"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#191F26" BorderBrush="#303943" BorderThickness="0,0,0,1"><Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Border Background="#74E0B3" CornerRadius="8" Width="36" Height="36"><TextBlock Text="帧" FontSize="21" FontWeight="Bold" Foreground="#102D22" HorizontalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="帧剪" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="FRAMECUT / PORTABLE" FontSize="9" Foreground="#8995A5" Margin="0,2,0,0"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Import" Content="新建视频" ToolTip="Ctrl+O · 新建工程并打开视频"/><Button x:Name="AddVideo" Content="＋ 添加视频到工程" ToolTip="Ctrl+Shift+O · 支持多选；拖入视频也会追加到当前工程" Background="#294B3E" BorderBrush="#527C68" Foreground="#B4F2D5"/><Button x:Name="OpenProject" Content="打开工程"/><Button x:Name="SaveProject" Content="保存工程" ToolTip="Ctrl+S"/><Button x:Name="Undo" Content="↶" ToolTip="撤销 Ctrl+Z" FontSize="17" Padding="10,3"/><Button x:Name="Redo" Content="↷" ToolTip="重做 Ctrl+Y" FontSize="17" Padding="10,3"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Help" Content="快捷键" Background="Transparent" BorderThickness="0"/><Button x:Name="Export" Content="导出  ↗" Style="{StaticResource Accent}" Padding="24,9"/></StackPanel>
   </Grid></Border>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#171D24" BorderBrush="#2D3540" BorderThickness="0,0,1,0"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="素材" FontWeight="SemiBold" FontSize="13"/>
     <Border Grid.Row="1" Background="#202831" CornerRadius="7" Margin="0,12,0,20" Padding="12"><StackPanel><TextBlock x:Name="SourceName" Text="尚未导入视频" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock x:Name="SourceMeta" Text="MP4 · MOV · MKV · AVI…" Foreground="#8995A5" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
     <Grid Grid.Row="2" Margin="0,0,0,12"><TextBlock Text="画面播放顺序" FontWeight="SemiBold"/><TextBlock x:Name="ClipCount" Text="00" HorizontalAlignment="Right" Foreground="#8995A5"/></Grid>
     <ListBox x:Name="ClipList" Grid.Row="3"/>
     <StackPanel Grid.Row="4"><UniformGrid Columns="3"><Button x:Name="MoveUp" Content="前移" Padding="3,7"/><Button x:Name="MoveDown" Content="后移" Padding="3,7"/><Button x:Name="Duplicate" Content="复制" Padding="3,7"/></UniformGrid><Button x:Name="Remove" Content="移除选中片段" Foreground="#F1A9A9" Background="Transparent" Padding="6,7"/><TextBlock x:Name="SequenceDuration" Text="成片时长  00:00.000" Foreground="#8995A5" FontSize="11" Margin="3,10,0,0"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Column="1" Margin="18,14,18,8"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="源视频预览" Foreground="#8995A5"/><TextBlock x:Name="PreviewTag" Text="逐帧 · 精确定位" Foreground="#74E0B3" HorizontalAlignment="Right" FontSize="11"/></Grid>
     <Border Grid.Row="1" Background="#080B0E" CornerRadius="8" BorderBrush="#29323C" BorderThickness="1" ClipToBounds="True"><Grid x:Name="PreviewSurface">
      <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" ScrubbingEnabled="True"/>
      <Image x:Name="Still" Stretch="Uniform"/>
      <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="[  ▶  ]" FontSize="38" Foreground="#74E0B3" HorizontalAlignment="Center" Margin="0,0,0,20"/><TextBlock Text="从一个画面开始" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="拖入视频，或点击「导入视频」" Foreground="#8995A5" Margin="0,10,0,20"/><Button x:Name="Demo" Content="打开示例视频" Background="#203A32" BorderBrush="#3B7660" Foreground="#9DE9C8" HorizontalAlignment="Center"/></StackPanel>
      <Border x:Name="DecodeBadge" Background="#D01B232D" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4" Margin="10" Padding="8,4" Visibility="Collapsed"><TextBlock Text="正在定位精确帧…" Foreground="#B7C8DA" FontSize="10"/></Border>
     </Grid></Border>
     <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PrevTen" Content="−10" Padding="8,8" ToolTip="Shift+← 后退 10 帧"/><Button x:Name="PrevFrame" Content="❮|" Padding="10,8" ToolTip="← 上一帧"/><Button x:Name="Play" Content="▶" Width="42" Style="{StaticResource Accent}" ToolTip="空格 播放 / 暂停"/><Button x:Name="NextFrame" Content="|❯" Padding="10,8" ToolTip="→ 下一帧"/><Button x:Name="NextTen" Content="+10" Padding="8,8" ToolTip="Shift+→ 前进 10 帧"/></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="Timecode" Text="00:00:00.000" FontFamily="Consolas" FontSize="17" HorizontalAlignment="Right"/><TextBlock x:Name="FrameLabel" Text="第 — / — 帧" Foreground="#8995A5" FontSize="10" HorizontalAlignment="Right"/><TextBlock x:Name="OutputTimecode" Text="成片 00:00.000 / 00:00.000" Foreground="#74E0B3" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
     </Grid>
    </Grid>
    <Border Grid.Column="2" Background="#171D24" BorderBrush="#2D3540" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,18,18,15">
     <Grid><TextBlock Text="精准裁剪" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="FRAME ACCURATE" FontSize="9" Foreground="#8995A5" HorizontalAlignment="Right"/></Grid>
     <TextBlock Text="保留以下帧，包含入点和出点" Foreground="#8995A5" FontSize="11" Margin="0,9,0,12"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="入点 / 帧" Foreground="#8995A5" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="InFrame" Text="1"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="出点 / 帧" Foreground="#8995A5" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="OutFrame" Text="1"/></StackPanel></Grid>
     <UniformGrid Columns="2" Margin="-3,5,-3,0"><Button x:Name="MarkIn" Content="设为入点  I" Padding="3,7"/><Button x:Name="MarkOut" Content="设为出点  O" Padding="3,7"/></UniformGrid>
     <Button x:Name="ApplyTrim" Content="应用帧范围" Margin="0,6,0,3" Padding="8,7"/>
     <UniformGrid Columns="2" Margin="-3,3,-3,0"><Button x:Name="Split" Content="分割画轨  S" Padding="4,7"/><Button x:Name="Snapshot" Content="保存此帧" Padding="4,7"/></UniformGrid>
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="JumpFrame" Text="1" ToolTip="输入要定位的帧号，按回车"/><Button x:Name="Jump" Grid.Column="1" Content="定位帧" Padding="10,6" Margin="6,0,0,0"/></Grid>
     <Border Height="1" Background="#303943" Margin="0,18,0,16"/>
     <TextBlock Text="音画轨道" FontSize="14" FontWeight="SemiBold"/>
     <CheckBox x:Name="KeepOriginal" Content="只剪画轨，原声保持连续" IsChecked="True"/>
     <CheckBox x:Name="Detach" Content="分离音画轨，独立调整音频"/>
     <TextBlock x:Name="AudioHint" Text="音画联动：裁剪画面时同步裁剪声音" Foreground="#8995A5" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <StackPanel x:Name="AudioControls"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="音频入点 / 秒" Foreground="#8995A5" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="AudioIn" Text="0.000"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="音频出点 / 秒" Foreground="#8995A5" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="AudioOut" Text="0.000"/></StackPanel></Grid><Button x:Name="ApplyAudio" Content="应用音频范围" Margin="0,7,0,2" Padding="6,7"/></StackPanel>
     <CheckBox x:Name="Mute" Content="静音此片段"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="音量" FontSize="11" Foreground="#8995A5"/><Slider x:Name="Volume" Grid.Column="1" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="8,0"/><TextBlock x:Name="VolumeLabel" Grid.Column="2" Text="100%" Width="34" FontSize="10"/></Grid>
    </StackPanel></ScrollViewer></Border>
   </Grid>
   <Border Grid.Row="2" Background="#151B22" BorderBrush="#303943" BorderThickness="0,1,0,1"><Grid Margin="18,10,18,9"><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <Grid><StackPanel Orientation="Horizontal"><Button x:Name="SequenceView" Content="成片编排" Style="{StaticResource Accent}" Padding="10,5"/><Button x:Name="SourceView" Content="原片定位 / 裁剪" Padding="10,5"/><Button x:Name="SplitTrack" Content="✂ 分割画轨 S" Padding="10,5"/><Button x:Name="PlayAll" Content="▶ 从头预览" Padding="10,5"/><TextBlock x:Name="LinkLabel" Text="● 原声连续" Foreground="#74E0B3" FontSize="10" Margin="12,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="缩放" Foreground="#8995A5" FontSize="10"/><Slider x:Name="Zoom" Width="90" Minimum="1" Maximum="32" Value="1" Margin="8,0"/><Button x:Name="Fit" Content="适应" Padding="8,3" FontSize="10"/></StackPanel></Grid>
    <Grid x:Name="TimelineHost" Grid.Row="1" ClipToBounds="True"/>
    <Grid x:Name="SequenceHost" Grid.Row="1" ClipToBounds="True"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="ZoomLabel" Text="1.0×" Foreground="#8995A5" FontSize="10"/><ScrollBar x:Name="Pan" Grid.Column="1" Orientation="Horizontal" Minimum="0" Maximum="0" SmallChange="0.5" LargeChange="3"/></Grid>
   </Grid></Border>
   <Grid Grid.Row="3" Margin="18,0"><TextBlock x:Name="Status" Text="添加视频到工程 → 分割 / 拖动排序 → 拼接导出" Foreground="#8995A5" FontSize="11"/><TextBlock x:Name="ExportSummary" Text="绿色版 1.2.1  /  无需安装" Foreground="#8995A5" FontSize="10" HorizontalAlignment="Right"/></Grid>
  </Grid>
  <Grid x:Name="BusyOverlay" Background="#D50A0F14" Visibility="Collapsed"><Border Background="#202832" BorderBrush="#455161" BorderThickness="1" CornerRadius="12" Width="430" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock x:Name="BusyTitle" Text="正在处理" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="BusyDetail" Text="请稍候…" Foreground="#A8B5C4" Margin="0,14,0,20" TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="7" Foreground="#74E0B3" Background="#10171D" Minimum="0" Maximum="100"/><TextBlock x:Name="ProgressText" Text="0%" Foreground="#74E0B3" HorizontalAlignment="Right" Margin="0,10,0,10"/><Button x:Name="Cancel" Content="取消" HorizontalAlignment="Right" Padding="24,8"/></StackPanel></Border></Grid>
 </Grid>
</Window>
